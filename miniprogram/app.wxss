page {
  min-height: 100%;
  background: #f3efe5;
  color: #123f31;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, input, textarea, button, image, picker { box-sizing: border-box; }
button::after { border: 0; }

.page-shell { min-height: 100vh; padding: 44rpx 34rpx 120rpx; }
.safe-page { padding-bottom: calc(130rpx + env(safe-area-inset-bottom)); }
.brand-row { display: flex; align-items: center; gap: 18rpx; }
.brand-logo { width: 72rpx; height: 72rpx; border-radius: 22rpx; box-shadow: 0 14rpx 34rpx rgba(18, 63, 49, .12); }
.brand-name { font-family: "Songti SC", "STSong", serif; font-size: 36rpx; font-weight: 600; letter-spacing: 2rpx; }
.brand-note { display: block; margin-top: 2rpx; color: #70867b; font-size: 16rpx; letter-spacing: 5rpx; }
.eyebrow { color: #d99b2f; font-size: 18rpx; font-weight: 700; letter-spacing: 5rpx; }
.display-title { font-family: "Songti SC", "STSong", serif; font-size: 70rpx; font-weight: 500; line-height: 1.12; letter-spacing: -3rpx; }
.display-title text { display: block; white-space: nowrap; }
.section-title { font-family: "Songti SC", "STSong", serif; font-size: 46rpx; font-weight: 600; line-height: 1.18; }
.muted { color: #70867b; }
.gold { color: #d99b2f; }

.primary-button, .secondary-button, .danger-button {
  min-height: 96rpx;
  padding: 0 34rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1;
}
.primary-button { background: #123f31; color: #fbfaf6; box-shadow: 0 20rpx 42rpx rgba(18, 63, 49, .18); }
.primary-button[disabled] { background: #a7b5ae; color: #edf0ee; box-shadow: none; }
.secondary-button { border: 2rpx solid rgba(18, 63, 49, .22); background: transparent; color: #123f31; }
.danger-button { border: 2rpx solid rgba(163, 70, 61, .3); background: transparent; color: #a3463d; }
.button-press { transform: scale(.98); }

.field { margin-top: 30rpx; }
.field-label { display: block; margin-bottom: 14rpx; color: #365f50; font-size: 24rpx; font-weight: 650; }
.input, .textarea, .picker-field {
  width: 100%;
  min-height: 94rpx;
  padding: 0 28rpx;
  border: 2rpx solid rgba(18, 63, 49, .14);
  border-radius: 22rpx;
  background: #fbfaf6;
  color: #123f31;
  font-size: 30rpx;
}
.textarea { min-height: 280rpx; padding-top: 24rpx; line-height: 1.65; }
.picker-field { display: flex; align-items: center; justify-content: space-between; }
.field-help { margin-top: 10rpx; color: #7f9188; font-size: 21rpx; line-height: 1.55; }
.form-error { margin: 22rpx 0; padding: 20rpx 22rpx; border-left: 5rpx solid #a3463d; background: rgba(163, 70, 61, .08); color: #8d3d36; line-height: 1.55; }
.form-success { margin: 22rpx 0; color: #365f50; }

.paper-card { border: 2rpx solid rgba(18, 63, 49, .09); border-radius: 30rpx; background: #fbfaf6; box-shadow: 0 24rpx 60rpx rgba(18, 63, 49, .07); }
.empty-state { padding: 72rpx 38rpx; text-align: center; }
.empty-state .section-title { margin-bottom: 18rpx; }
.loading-copy { padding: 150rpx 0; color: #70867b; text-align: center; letter-spacing: 5rpx; }
.privacy-note { color: #7f9188; font-size: 21rpx; line-height: 1.65; text-align: center; }
.privacy-note navigator { display: inline; color: #365f50; font-weight: 650; }

.entry-share { display: block; margin: 22rpx 0 0 auto; width: fit-content; padding: 0 28rpx; background: transparent; border: 1rpx solid #b5c4bb; color: #365f50; font-size: 25rpx; border-radius: 999rpx; }
.entry-actions { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16rpx; margin-top: 22rpx; }
.entry-actions .entry-share { margin: 0 0 0 auto; }
.entry-delete { margin: 0; padding: 0 20rpx; min-height: 72rpx; display: flex; align-items: center; background: #f7eae6; color: #963f36; font-size: 25rpx; border-radius: 999rpx; }
.mode-options { display: flex; gap: 12rpx; margin-bottom: 28rpx; padding: 8rpx; border-radius: 24rpx; background: rgba(255,255,255,.12); }
.mode-options button { flex: 1; padding: 0 12rpx; font-size: 28rpx; color: #fffdf8; background: transparent; border-radius: 18rpx; }
.mode-options .chosen { background: #fffdf8; color: #143d2f; font-weight: 700; }
.journey-note { padding: 28rpx; margin-top: 28rpx; font-size: 27rpx; line-height: 1.8; }
.entry-photo-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin: 18rpx 0; }
.entry-photo-grid image { width: 100%; height: 220rpx; border-radius: 14rpx; margin: 0; }
.entry-photo-grid image:only-child { grid-column: 1 / -1; height: 380rpx; }
.journey-note text { display: block; }
.journey-note text:first-child { color: #a4731c; font-weight: 700; margin-bottom: 10rpx; }
@media (prefers-color-scheme: dark) {
  page { background: #0f1c17; color: #edf3ef; }
  .page-shell { background: #0f1c17; }
  .paper-card, .input, .textarea, .picker-field { border-color: rgba(237, 243, 239, .12); background: #192a22; color: #edf3ef; }
  .field-label, .secondary-button { color: #d5e2da; }
  .secondary-button { border-color: rgba(237, 243, 239, .22); }
  .muted, .field-help, .privacy-note { color: #91a69b; }
  .entry-share { color: #d5e2da; border-color: #728c7c; }
}
/* Heavy media is deliberately absent from list src attributes until opened. */
.media-placeholder { display: flex; align-items: center; justify-content: center; min-height: 200rpx; padding: 24rpx; border-radius: 20rpx; background: #e3ece3; color: #123f31; font-size: 26rpx; }
.entry-actions { flex-wrap: wrap; gap: 12rpx; }
