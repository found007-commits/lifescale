<wxs src="../../utils/locale.wxs" module="i18n" />
<view class="page-shell record-page">
  <text class="eyebrow">{{i18n.t('TODAY · 只属于你', locale)}}</text>
  <view class="display-title record-title"><text>{{i18n.t('今天，发生了什么？', locale)}}</text></view>
  <text class="record-intro">{{i18n.t('一句话或一张照片，留给自己。', locale)}}</text>

  <view class="paper-card composer">
    <textarea class="textarea" disabled="{{saving || persisted}}" value="{{content}}" bindinput="onContentInput" maxlength="12000" placeholder="{{i18n.t('写下你想记住的片刻……', locale)}}" auto-height="false" />
    <button class="inspiration-toggle" bindtap="toggleInspiration" disabled="{{saving || persisted}}" aria-expanded="{{inspirationOpen}}">{{i18n.t(inspirationOpen ? '收起灵感' : '需要一点灵感？', locale)}}</button>
    <view wx:if="{{inspirationOpen}}" class="inspiration-options">
    <view class="choice-row inspiration-topics">
      <button class="choice-pill {{topic === -1 ? 'active' : ''}}" data-index="-1" bindtap="chooseTopic">{{i18n.t('自由写', locale)}}</button>
      <button wx:for="{{topics}}" wx:key="label" class="choice-pill {{topic === index ? 'active' : ''}}" data-index="{{index}}" bindtap="chooseTopic">{{i18n.t(item.label, locale)}}</button>
    </view>
    <view wx:if="{{prompt}}" class="inspiration-card"><text>{{i18n.t(prompt, locale)}}</text><button bindtap="nextPrompt">{{i18n.t('换一句', locale)}}</button></view>
    </view>
    <view class="photo-choice-grid">
    <view wx:for="{{images}}" wx:key="id" class="image-preview">
      <view wx:if="{{item.kind === 'video'}}" class="media-placeholder">▶ {{i18n.t('视频已选好', locale)}}</view>
      <image wx:elif="{{item.tempFilePath}}" src="{{item.tempFilePath}}" mode="aspectFill" />
      <text wx:else>{{item.error || i18n.t('正在处理照片…', locale)}}</text>
      <button data-index="{{index}}" disabled="{{saving || processing || persisted}}" bindtap="removeImage">{{index + 1}} · {{i18n.t('移除', locale)}}</button>
    </view>
    </view>
    <button class="photo-button" disabled="{{saving || processing || persisted}}" bindtap="chooseImage">{{i18n.t(processing ? '正在处理媒体…' : '＋ 从手机相册添加', locale)}}</button>
    <text class="upload-hint">{{i18n.t('可选择照片或视频，也可以不写文字。GIF 能否选取取决于手机相册与微信版本；收到 GIF 原文件时保留动画。视频点开再加载，不自动播放。单个文件处理后需在 50 MB 以内。', locale)}}</text>
    <text wx:if="{{notice}}" class="upload-hint">{{i18n.t(notice, locale)}}</text>
    <text wx:if="{{progress}}" class="upload-hint">{{i18n.t(processing ? '正在处理照片…' : '正在上传照片…', locale)}} {{progress}}</text>

    <view class="record-metadata">
      <view><text class="field-label">{{i18n.t('此刻的心情', locale)}}</text><picker range="{{moodPickerLabels}}" value="{{moodIndex}}" bindchange="onMoodChange" disabled="{{saving || persisted}}"><view class="metadata-picker">{{i18n.t(moods[moodIndex].label, locale)}} <text>⌄</text></view></picker></view>
      <view><text class="field-label">{{i18n.t('分类', locale)}}</text><picker range="{{categoryPickerLabels}}" value="{{categoryIndex}}" bindchange="onCategoryChange" disabled="{{saving || persisted}}"><view class="metadata-picker">{{i18n.t(categories[categoryIndex].label, locale)}} <text>⌄</text></view></picker></view>
    </view>
    <view wx:if="{{error}}" class="form-error">{{i18n.t(error, locale)}}</view>
    <text wx:if="{{guest}}" class="upload-hint">{{i18n.t('此时尚未上传。登录后会继续保存；离开或关闭小程序会丢失未保存内容。', locale)}}</text>
    <button class="primary-button save-entry" bindtap="saveEntry" loading="{{saving}}" disabled="{{saving || processing || saved}}">{{i18n.t(saved ? '今天已留下' : (guest ? '登录并私密保存' : (persisted ? '重试剩余上传' : '仅自己可见，保存今天')), locale)}}</button>
  </view>
  <canvas type="2d" id="photoCanvas" class="render-canvas" />
  <view wx:if="{{privacyOpen}}" class="privacy-mask">
    <view class="privacy-dialog">
      <text class="privacy-title">{{i18n.t('从相册选择照片或视频前，需要你先同意《小程序用户隐私保护指引》。', locale)}}</text>
      <button class="privacy-contract" bindtap="onPrivacyContract">{{i18n.t('隐私政策', locale)}}</button>
      <view class="privacy-actions">
        <button class="privacy-decline" bindtap="onPrivacyDecline">{{i18n.t('暂不', locale)}}</button>
        <button id="privacy-agree" class="primary-button" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onPrivacyAgree">{{i18n.t('同意并继续', locale)}}</button>
      </view>
    </view>
  </view>
</view>
