.share-page { padding-top: 40rpx; padding-bottom: calc(270rpx + env(safe-area-inset-bottom)); }
.share-header { margin-bottom: 28rpx; }
.share-header .section-title { display: block; margin: 20rpx 0; font-size: 46rpx; }
.share-note { display: block; margin: 18rpx 0; color: var(--text-secondary); font-size: 25rpx; line-height: 1.75; }
.ui-207 .settings-toggle { margin: 20rpx 0; padding: 18rpx 0; width: 100%; text-align: left; background: transparent; color: var(--text-primary); font-size: 26rpx; }
.share-settings { padding: 24rpx; margin-bottom: 28rpx; }
.selection-entry { margin: 0 0 28rpx; }
.layout-options { display: flex; gap: 8rpx; padding: 8rpx; background: var(--bg-card-hover); border-radius: var(--radius-sm); }
.layout-options button { flex: 1; min-width: 0; width: 0; margin: 0; padding: 16rpx 8rpx; border-radius: 12rpx; background: transparent; color: var(--text-secondary); }
.layout-options .selected { background: var(--text-primary); color: var(--bg-main); }
.setting-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--border-subtle); font-size: 26rpx; line-height: 1.6; }
.setting-row text { flex: 1; min-width: 0; }
.setting-row switch { flex-shrink: 0; }
.settings-note { display: block; margin-top: 18rpx; color: var(--text-secondary); font-size: 24rpx; line-height: 1.75; overflow-wrap: anywhere; }
.preview-scroll { height: 48vh; margin: 24rpx 0; border-radius: var(--radius-md); background: var(--bg-card-hover); }
.card-item { padding: 10rpx; border: 2rpx solid transparent; border-radius: var(--radius-md); margin: 20rpx 0; text-align: center; }
.card-item.chosen { border-color: var(--accent-gold); }
.preview-scroll .card-item:first-child { margin-top: 0; }
.card-item image { display: block; width: 100%; border-radius: 12rpx; }
.card-item text { display: block; margin-top: 14rpx; color: var(--text-secondary); font-size: 24rpx; line-height: 1.6; }
.share-actions { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--border-subtle); background: var(--bg-main); }
.share-action-buttons { display: flex; gap: 16rpx; max-width: 960rpx; margin: 0 auto; }
.share-action-buttons button { flex: 1; width: 0; min-width: 0; margin: 0; padding: 20rpx 12rpx; font-size: 27rpx; line-height: 1.5; }
.share-action-note { display: block; margin-bottom: 14rpx; text-align: center; color: var(--text-secondary); font-size: 24rpx; }
.render-canvas { position: fixed; left: -10000px; top: 0; width: 720px; height: 900px; pointer-events: none; }
.share-backgrounds { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 24rpx 0; }
.share-backgrounds > text { width: 100%; font-size: 24rpx; line-height: 1.7; }
.share-backgrounds button { width: 120rpx; margin: 0; padding: 6rpx; border: 2rpx solid var(--border-subtle); border-radius: 12rpx; background: var(--bg-card-hover); font-size: 24rpx; }
.share-backgrounds button.selected { border-color: var(--accent-gold); }
.share-backgrounds image { display: block; width: 104rpx; height: 100rpx; border-radius: 8rpx; }
.selection-panel { padding: 26rpx; margin: 24rpx 0; }
.selection-panel .textarea { min-height: 320rpx; margin-bottom: 24rpx; }
.selection-panel > button { margin-top: 20rpx; }
.selection-photos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.selection-photos button { width: 100%; margin: 0; padding: 6rpx; border: 2rpx solid var(--border-subtle); border-radius: 12rpx; background: var(--bg-card-hover); color: var(--text-secondary); font-size: 24rpx; }
.selection-photos button.selected { border-color: var(--accent-gold); background: var(--accent-gold-glow); color: var(--accent-gold); }
.selection-photos image { display: block; width: 100%; height: 138rpx; border-radius: 8rpx; }
@media (max-width: 360px) { .selection-photos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
