.onboarding-page { padding-top: 60rpx; }
.hero-header { margin-bottom: 36rpx; }
.onboarding-title { margin: 20rpx 0; }
.onboarding-intro { display: block; color: var(--text-secondary); font-size: 27rpx; line-height: 1.75; }
.warning-card { padding: 28rpx; border: 1rpx dashed var(--border-active); border-radius: var(--radius-md); background: var(--accent-gold-glow); color: var(--text-secondary); font-size: 25rpx; line-height: 1.75; }
.warning-label { display: block; margin-bottom: 12rpx; color: var(--accent-gold); font-weight: 650; }
.onboarding-form { margin-top: 28rpx; padding: 4rpx 28rpx 32rpx; }
.onboarding-form .field { margin-top: 28rpx; }
.gauge-card { padding: 28rpx 22rpx; border: 1rpx solid var(--border-subtle); border-radius: var(--radius-md); background: var(--bg-main); text-align: center; }
.gauge-card .field-label { color: var(--accent-gold); }
.gauge-card .age-input { height: 130rpx; min-height: 130rpx; padding: 0 8rpx; border: 0; border-radius: 0; background: transparent; font-family: var(--font-mono); font-size: 100rpx; font-weight: 700; text-align: center; }
.gauge-card .field-help { font-size: 24rpx; text-align: left; }
.confirm-row { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 30rpx; color: var(--text-secondary); font-size: 25rpx; line-height: 1.75; }
.confirm-row checkbox { flex-shrink: 0; margin-top: 4rpx; }
.confirm-row text { min-width: 0; flex: 1; }
.save-profile { margin-top: 32rpx; }
.onboarding-form > .secondary-button { margin-top: 18rpx; }
