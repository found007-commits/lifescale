<wxs src="../../utils/locale.wxs" module="i18n" />
<view class="page-shell safe-page dashboard-page">
  <view wx:if="{{loading}}" class="loading-copy">{{i18n.t('正在打开今天', locale)}}</view>
  <block wx:else>
    <view wx:if="{{error}}" class="form-error">{{error}}</view>
    <view wx:if="{{!profile && !error}}" class="paper-card empty-state">
      <text class="eyebrow">TODAY · JUST FOR YOU</text>
      <text class="section-title">{{i18n.t('先留下今天', locale)}}</text>
      <text class="muted">{{i18n.t('不急着设定年龄。你可以先记录，想好了再开启人生刻度。', locale)}}</text>
      <button class="primary-button empty-action" bindtap="recordToday">{{i18n.t('记录今天 +1', locale)}}</button>
      <button class="secondary-button empty-action" bindtap="viewHistory">{{i18n.t('查看我的记录', locale)}}</button>
      <button class="secondary-button empty-action" bindtap="setupTimeline">{{i18n.t('设定人生刻度（可稍后）', locale)}}</button>
    </view>
    <block wx:if="{{profile && metrics}}">
      <view class="today-header">
        <text class="eyebrow">TODAY · {{metrics.today}}</text>
        <view class="display-title today-title"><text>{{i18n.t(metrics.isBonus ? '生命加时，今天又赚到一天。' : '今天，也值得被记住。', locale)}}</text></view>
        <text class="muted">{{i18n.t('这不是死亡预测，而是你为自己设定的人生时间目标。', locale)}}</text>
      </view>

      <button class="today-button {{checkedToday ? 'done' : ''}}" bindtap="recordToday" hover-class="button-press">
        <text class="today-plus">{{checkedToday ? '✓' : '+1'}}</text>
        <view><text class="today-main">{{i18n.t(checkedToday ? '再记一笔' : '记录今天 +1', locale)}}</text><text class="today-note">{{i18n.t('一句话、一张图，也足够', locale)}}</text></view>
      </button>
      <view class="life-card {{profile.display_mode === 'clear' ? 'life-clear' : 'life-gentle'}}">
        <view class="mode-options"><button class="{{profile.display_mode === 'gentle' ? 'chosen' : ''}}" data-mode="gentle" bindtap="setMode" disabled="{{switching}}">{{i18n.t('温和模式', locale)}}</button><button class="{{profile.display_mode === 'clear' ? 'chosen' : ''}}" data-mode="clear" bindtap="setMode" disabled="{{switching}}">{{i18n.t('清醒模式', locale)}}</button></view>
        <view wx:if="{{profile.display_mode !== 'clear'}}" class="gentle-view">
        <text class="mode-message">{{i18n.t(metrics.isBonus ? '目标之外，生活仍在继续。' : '慢慢来，认真过好今天。', locale)}}</text>
        <view class="dial" style="background: conic-gradient(#487359 {{metrics.progress}}%, #cbdacc 0)">
          <view class="dial-inner">
            <text>{{i18n.t(metrics.isBonus ? '生命加时' : '仍可书写', locale)}}</text>
            <text class="dial-number">{{metrics.displayDaysText}}</text>
            <text>{{i18n.t('天', locale)}}</text>
          </view>
        </view>
        </view>
        <view wx:else class="clear-view">
          <text class="clear-label">{{i18n.t(metrics.isBonus ? '已超过设定目标' : '距设定目标还剩', locale)}}</text>
          <view class="clear-count"><text class="clear-number">{{metrics.displayDaysText}}</text><text class="clear-unit">{{i18n.t('天', locale)}}</text></view>
          <text class="clear-message">{{i18n.t(metrics.isBonus ? '目标已走过，今天仍由你安排。' : '今天，你想留下什么？', locale)}}</text>
          <view class="clear-progress-head"><text>{{i18n.t('设定目标进度', locale)}}</text><text class="clear-percent">{{metrics.progressText}}%</text></view>
          <view class="clear-progress-track"><view class="clear-progress-fill" style="width: {{metrics.progress}}%"></view></view>
          <view class="clear-facts"><text>{{i18n.t('已走过', locale)}} {{metrics.livedDaysText}} {{i18n.t('天', locale)}}</text><text wx:if="{{!metrics.isBonus}}">{{i18n.t('剩余周数', locale)}} {{metrics.weeksText}} {{i18n.t('周', locale)}}</text></view>
        </view>
        <text class="mode-disclaimer">{{i18n.t('按你设定的目标年龄计算，并非寿命预测。', locale)}}</text>
        <button class="details-toggle" bindtap="toggleDetails" aria-expanded="{{detailsOpen}}">{{i18n.t(detailsOpen ? '收起时间详情' : '查看时间详情', locale)}}</button>
        <view wx:if="{{detailsOpen}}" class="metric-grid">
          <view><text>{{i18n.t('已走过', locale)}}</text><text class="metric-value">{{metrics.livedDaysText}} {{i18n.t('天', locale)}}</text></view>
          <view><text>{{i18n.t('生命进度', locale)}}</text><text class="metric-value">{{metrics.progressText}}%</text></view>
          <view><text>{{i18n.t('剩余周数', locale)}}</text><text class="metric-value">{{metrics.weeksText}} {{i18n.t('周', locale)}}</text></view>
          <view><text>{{i18n.t('留下记录', locale)}}</text><text class="metric-value">{{checkinCount}} {{i18n.t('天', locale)}}</text></view>
        </view>
      </view>

      <view class="paper-card journey-note"><text>{{i18n.t('第', locale)}} {{checkinCount || 1}} {{i18n.t('天', locale)}}</text><text>{{i18n.t(journeyMessage, locale)}}</text></view>

      <view class="recent-head">
        <view><text class="eyebrow">RECENT DAYS</text><text class="section-title">{{i18n.t('最近留下的日子', locale)}}</text></view>
        <button class="view-all" bindtap="viewHistory">{{i18n.t('查看全部', locale)}}</button>
      </view>
      <view wx:if="{{recentEntries.length}}" class="recent-list">
        <view wx:for="{{recentEntries}}" wx:key="id" class="paper-card entry-card">
          <view class="entry-photo-grid"><image wx:for="{{item.imageUrls}}" wx:for-item="photo" wx:for-index="photoIndex" wx:key="*this" src="{{photo}}" mode="aspectFill" data-entry="{{index}}" data-photo="{{photoIndex}}" bindtap="previewPhoto" /></view>
          <view class="entry-meta"><text>{{item.dateLabel}}</text><text>{{i18n.t('仅自己可见', locale)}}</text></view>
          <text class="entry-content">{{item.content || '今天 +1'}}</text>
          <view class="entry-tags"><text>{{i18n.t(item.moodLabel, locale)}}</text><text>{{i18n.t(item.categoryLabel, locale)}}</text></view>
          <view class="entry-actions">
            <button class="entry-delete" data-index="{{index}}" catchtap="removeEntry">{{i18n.t('删除', locale)}}</button>
            <button class="entry-share" data-index="{{index}}" catchtap="shareEntry">{{i18n.t('分享这一天 ↗', locale)}}</button>
          </view>
        </view>
      </view>
      <view wx:else class="paper-card empty-state">
        <text class="section-title">{{i18n.t('第一条记录，从今天开始。', locale)}}</text>
        <text class="muted">{{i18n.t('无需写得完整，真实就好。', locale)}}</text>
        <button class="primary-button empty-action" bindtap="recordToday">{{i18n.t('记录今天 +1', locale)}}</button>
      </view>
    </block>
  </block>
</view>
