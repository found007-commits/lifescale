.share-page { padding-top: 36rpx; padding-bottom: calc(50rpx + env(safe-area-inset-bottom)); }
.section-title { display: block; margin: 18rpx 0; }
.share-note { display: block; color: #526c60; font-size: 24rpx; line-height: 1.8; margin: 18rpx 0; }
.layout-options { display: flex; padding: 8rpx; background: #e5e8e1; border-radius: 24rpx; gap: 10rpx; }
.layout-options button { flex: 1; background: transparent; color: #143d2f; font-size: 28rpx; border-radius: 18rpx; }
.layout-options .selected { background: #143d2f; color: #fffdf8; }
.layout-options button[disabled] { opacity: .55; }
.card-item { padding: 8rpx; border: 3rpx solid transparent; border-radius: 20rpx; margin: 24rpx 0; text-align: center; }
.card-item.chosen { border-color: #a87316; }
.card-item image { display: block; width: 100%; border-radius: 12rpx; }
.card-item text { display: block; font-size: 24rpx; margin-top: 12rpx; }
.share-actions { display: grid; gap: 16rpx; }
.preview-scroll { height: 48vh; margin: 16rpx 0 24rpx; }
.preview-scroll .card-item:first-child { margin-top: 0; }
.render-canvas { position: fixed; left: -10000px; top: 0; width: 720px; height: 900px; pointer-events: none; }
.share-backgrounds { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 20rpx 0; }
.share-backgrounds > text { width: 100%; font-size: 24rpx; line-height: 1.7; }
.share-backgrounds button { width: 116rpx; padding: 6rpx; margin: 0; border: 3rpx solid transparent; background: #e5e8e1; font-size: 22rpx; }
.share-backgrounds button.selected { border-color: #a87316; }
.share-backgrounds image { display: block; width: 98rpx; height: 90rpx; }
.selection-panel { padding: 26rpx; margin: 24rpx 0; }
.selection-panel .textarea { min-height: 320rpx; margin-bottom: 24rpx; }
.selection-panel > button { margin-top: 20rpx; }
.selection-photos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; }
.selection-photos button { width: 100%; padding: 6rpx; margin: 0; border: 3rpx solid #c6cec8; background: #e8e7df; color: #476b5d; font-size: 22rpx; line-height: 1.8; }
.selection-photos button.selected { border-color: #123f31; background: #123f31; color: #fffdf8; }
.selection-photos image { display: block; width: 100%; height: 138rpx; border-radius: 8rpx; }
