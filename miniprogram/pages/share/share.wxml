<wxs src="../../utils/locale.wxs" module="i18n" />
<view class="page-shell share-page">
  <text class="eyebrow">SHARE A DAY</text>
  <text class="section-title">{{i18n.t('分享这一天', locale)}}</text>
  <text class="share-note">{{i18n.t('只分享你选中的内容，原记录仍仅自己可见。', locale)}}</text>
  <view wx:if="{{editing}}" class="selection-panel paper-card">
    <text class="field-label">{{i18n.t('分享副本里的文字', locale)}}</text>
    <text class="share-note">{{i18n.t('可以删减或改写。只修改分享副本，不影响原记录。', locale)}}</text>
    <textarea class="textarea" value="{{shareText}}" bindinput="onShareText" maxlength="12000" placeholder="{{i18n.t('也可以清空文字，只分享照片', locale)}}" />
    <text wx:if="{{photoChoices.length}}" class="field-label">{{i18n.t('点击照片，选择保留或取消', locale)}}</text>
    <view class="selection-photos">
      <button wx:for="{{photoChoices}}" wx:key="index" data-index="{{index}}" bindtap="togglePhoto" class="{{item.selected ? 'selected' : ''}}">
        <image src="{{item.url}}" mode="aspectFill" /><text>{{index + 1}} · {{i18n.t(item.selected ? '已选择' : '不分享', locale)}}</text>
      </button>
    </view>
    <view wx:if="{{selectionError}}" class="form-error">{{selectionError}}</view>
    <button class="primary-button" bindtap="applySelection">{{i18n.t('更新分享预览', locale)}}</button>
    <button class="secondary-button" bindtap="cancelSelection">{{i18n.t('取消本次修改', locale)}}</button>
  </view>
  <block wx:if="{{!editing}}">
  <button class="settings-toggle" bindtap="toggleSettings" disabled="{{busy || saving || sharing}}" aria-expanded="{{settingsOpen}}">{{i18n.t('分享设置', locale)}} · {{i18n.t(settingsOpen ? '收起' : '展开', locale)}}</button>
  <view wx:if="{{settingsOpen}}" class="share-settings paper-card">
    <button class="secondary-button selection-entry" bindtap="editSelection" disabled="{{busy || saving || sharing}}">{{i18n.t('选择分享的文字和照片', locale)}}</button>
    <text class="field-label">{{i18n.t('分享卡排版', locale)}}</text>
    <view class="layout-options">
      <button class="{{layout === 'separate' ? 'selected' : ''}}" data-layout="separate" bindtap="chooseLayout" disabled="{{busy || saving || sharing}}">{{i18n.t('图文分开', locale)}}</button>
      <button class="{{layout === 'overlay' ? 'selected' : ''}}" data-layout="overlay" bindtap="chooseLayout" disabled="{{busy || saving || sharing || !hasPhoto}}">{{i18n.t('文字镶嵌', locale)}}</button>
    </view>
    <view wx:if="{{layout === 'overlay' && imageUrls.length > 1}}" class="share-backgrounds">
      <text>{{i18n.t('选择背景图 · 已选照片都会保留', locale)}}</text>
      <button wx:for="{{imageUrls}}" wx:key="index" class="{{backgroundIndex === index ? 'selected' : ''}}" disabled="{{busy || saving || sharing}}" data-index="{{index}}" bindtap="chooseBackground"><image src="{{item}}" mode="aspectFill" /><text>{{index + 1}}</text></button>
    </view>
    <text class="share-note">{{i18n.t(hasPhoto ? (layout === 'overlay' ? '深色底板与米白文字，已选照片保留在文字后面。' : '已选照片按顺序完整排列，文字自动排成长图。') : '未选择照片，生成纯文字分享卡。', locale)}}</text>
    <label class="setting-row"><text>{{i18n.t('显示日期', locale)}}</text><switch checked="{{showDate}}" data-option="showDate" bindchange="changeShareOption" disabled="{{busy || saving || sharing}}" color="#143d2f" /></label>
    <label class="setting-row"><text>{{i18n.t('显示心情与分类', locale)}}</text><switch checked="{{showMood}}" data-option="showMood" bindchange="changeShareOption" disabled="{{busy || saving || sharing}}" color="#143d2f" /></label>
    <label class="setting-row"><text>{{i18n.t('显示昵称署名', locale)}}</text><switch checked="{{showSignature}}" data-option="showSignature" bindchange="changeShareOption" disabled="{{busy || saving || sharing || !nickname}}" color="#143d2f" /></label>
    <text class="settings-note">{{i18n.t(nickname ? '开启后将显示此昵称：' : '尚未设置昵称。可在个人偏好中设置，也可以不署名。', locale)}}{{nickname}}</text>
    <text class="settings-note">{{i18n.t('仅影响本次分享；更改后会重新生成预览。', locale)}}</text>
  </view>
  <text wx:if="{{busy}}" class="loading-copy">{{i18n.t('正在生成完整分享卡…', locale)}}</text>
  <view wx:if="{{error}}" class="form-error">{{error}}<button bindtap="generate" class="secondary-button">{{i18n.t('重试', locale)}}</button></view>
  <text wx:if="{{cards.length > 1}}" class="share-note">{{i18n.t('记录较长，为保证清晰度已完整分成', locale)}} {{cards.length}} {{i18n.t('张。请选择一张发送，或逐张保存全部内容。', locale)}}</text>
  <scroll-view wx:if="{{cards.length}}" scroll-y="{{true}}" class="preview-scroll" enhanced="{{true}}">
  <view wx:for="{{cards}}" wx:key="path" class="card-item {{selected === index ? 'chosen' : ''}}" data-index="{{index}}" bindtap="selectCard">
    <image src="{{item.path}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
    <text wx:if="{{cards.length > 1}}">{{i18n.t(selected === index ? '已选中 · ' : '', locale)}}{{i18n.t('第', locale)}} {{index + 1}} {{i18n.t('张 /', locale)}} {{cards.length}}</text>
  </view>
  </scroll-view>
  <text class="share-note">{{i18n.t('图片发出后，无法阻止他人保存、截图或再次转发，请确认后分享。', locale)}}</text>
  <view class="share-actions">
    <text wx:if="{{cards.length > 1}}" class="share-action-note">{{i18n.t('当前选择', locale)}} {{selected + 1}} / {{cards.length}}</text>
    <view class="share-action-buttons">
    <button class="primary-button" bindtap="shareImage" disabled="{{busy || !cards.length || saving || sharing}}" loading="{{sharing}}">{{i18n.t('发送给朋友', locale)}}</button>
    <button class="secondary-button" bindtap="saveImage" disabled="{{busy || !cards.length || saving || sharing}}" loading="{{saving}}">{{i18n.t('保存图片', locale)}}</button>
    </view>
  </view>
  </block>
  <canvas type="2d" id="shareCanvas" class="render-canvas" />
</view>
