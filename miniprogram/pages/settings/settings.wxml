<wxs src="../../utils/locale.wxs" module="i18n" />
<view class="page-shell safe-page settings-page">
  <text class="eyebrow">MY LIFESCALE</text>
  <view class="display-title settings-title"><text>{{i18n.t('我的人生刻度', locale)}}</text></view>
  <view wx:if="{{loading}}" class="loading-copy">{{i18n.t('正在读取资料', locale)}}</view>
  <view wx:if="{{error}}" class="form-error">{{error}}</view>
  <block wx:if="{{!loading}}">
    <view wx:if="{{!profile && !error}}" class="paper-card profile-card">
      <text class="section-title">{{i18n.t('年龄目标，可以慢慢想。', locale)}}</text>
      <text class="muted">{{email || i18n.t('微信账户（未绑定邮箱）', locale)}}</text>
      <text class="field-help">{{i18n.t('不急着设定年龄。你可以先记录，想好了再开启人生刻度。', locale)}}</text>
      <button class="primary-button" bindtap="setupTimeline">{{i18n.t('设定人生刻度（可稍后）', locale)}}</button>
    </view>
    <view wx:if="{{profile}}" class="paper-card profile-card">
      <text class="profile-name">{{profile.display_name || '余生有刻用户'}}</text>
      <text class="muted">{{email || i18n.t('微信账户（未绑定邮箱）', locale)}}</text>
      <view class="profile-grid">
        <view><text>{{i18n.t('出生日期', locale)}}</text><text>{{birthLabel}}</text></view>
        <view wx:if="{{profile.target_age}}"><text>{{i18n.t('目标年龄', locale)}}</text><text>{{profile.target_age}} {{i18n.t('岁', locale)}}</text></view>
        <view><text>{{i18n.t('目标日期', locale)}}</text><text>{{targetLabel}}</text></view>
      </view>
      <view class="lock-note"><text>{{i18n.t('首次设定后一年内可修改 3 次；满一年后，每次修改需间隔一年，累计最多 7 次。首次设定不计次数。', locale)}}</text><text>{{i18n.t('出生日期确认后不可修改。', locale)}}</text></view>
      <text wx:if="{{policy.configured}}" class="field-help">{{i18n.t('累计剩余修改次数', locale)}} {{policy.remaining}} / 7</text>
      <text wx:if="{{policy.firstYear}}" class="field-help">{{i18n.t('首年剩余修改次数', locale)}} {{policy.firstYearRemaining}} / 3</text>
      <text wx:if="{{!policy.configured}}" class="field-help">{{i18n.t('暂时无法读取调整资格，请刷新后重试。', locale)}}</text>
      <text wx:elif="{{!policy.remaining}}" class="field-help">{{i18n.t('累计 7 次调整机会已用完。', locale)}}</text>
      <text wx:elif="{{!policy.canChange}}" class="field-help">{{i18n.t('下次可调整', locale)}} {{nextTargetLabel}}</text>
      <view wx:if="{{policy.canChange}}" class="field">
        <text class="field-label">{{i18n.t('目标年龄', locale)}}</text>
        <input class="input" type="number" maxlength="3" value="{{targetAgeInput}}" bindinput="onTargetAgeInput" disabled="{{adjusting}}" />
        <button class="primary-button" bindtap="adjustTarget" loading="{{adjusting}}" disabled="{{adjusting}}">{{i18n.t('调整目标年龄', locale)}}</button>
      </view>
    </view>
    <view wx:if="{{profile}}" class="paper-card profile-card">
      <text class="section-title">{{i18n.t('个人偏好', locale)}}</text>
      <view class="field"><text class="field-label">{{i18n.t('显示名称', locale)}}</text><input class="input" value="{{displayName}}" maxlength="80" bindinput="onNameInput" /></view>
      <view class="field"><text class="field-label">{{i18n.t('性别', locale)}}</text><picker range="{{genderPickerLabels}}" value="{{genderIndex}}" bindchange="onGenderChange"><view class="picker-field">{{i18n.t(genderLabels[genderIndex], locale)}} ›</view></picker></view>
      <view class="field"><text class="field-label">{{i18n.t('语言', locale)}}</text><picker range="{{languages}}" value="{{localeIndex}}" bindchange="onLocaleChange"><view class="picker-field">{{languages[localeIndex]}} ›</view></picker></view>
      <view class="field"><text class="field-label">{{i18n.t('显示模式', locale)}}</text><picker range="{{modePickerLabels}}" value="{{modeIndex}}" bindchange="onModeChange"><view class="picker-field">{{i18n.t(modes[modeIndex], locale)}} ›</view></picker></view>
      <button class="primary-button" bindtap="savePreferences" loading="{{saving}}" disabled="{{saving}}">{{i18n.t('保存个人偏好', locale)}}</button>
    </view>
    <view class="paper-card profile-card">
      <text class="section-title">{{i18n.t('登录方式', locale)}}</text>
      <text class="field-help">{{email ? i18n.t('可使用邮箱登录', locale) : i18n.t('此账户使用微信登录', locale)}}</text>
      <text wx:if="{{loginStatus && loginStatus.enabled}}" class="field-help">{{i18n.t(loginStatus.bound ? '微信已绑定，可直接登录' : '微信尚未绑定', locale)}}</text>
      <text wx:else class="field-help">{{i18n.t('微信绑定状态暂不可用，请稍后再试。', locale)}}</text>
      <button wx:if="{{loginStatus.enabled && email}}" class="secondary-button" bindtap="manageWechat">{{i18n.t(loginStatus.bound ? '解除微信绑定' : '绑定微信，保留原记录', locale)}}</button>
      <text wx:if="{{!email}}" class="field-help">{{i18n.t('以前有邮箱账户？退出后使用原邮箱登录即可找回原记录。两个账户不会自动合并。', locale)}}</text>
    </view>
    <view class="settings-list paper-card">
      <button bindtap="openSanctuary"><text>{{i18n.t('我的精神圣所', locale)}}</text><text>›</text></button>
      <button bindtap="exportData"><text>{{i18n.t('导出全部数据', locale)}}</text><text>JSON ↓</text></button>
      <button data-type="privacy" bindtap="openLegal"><text>{{i18n.t('隐私政策', locale)}}</text><text>›</text></button>
      <button data-type="terms" bindtap="openLegal"><text>{{i18n.t('服务条款', locale)}}</text><text>›</text></button>
      <button data-type="third" bindtap="openLegal"><text>{{i18n.t('第三方服务说明', locale)}}</text><text>›</text></button>
    </view>
    <button class="secondary-button signout-button" bindtap="signOut">{{i18n.t('退出登录', locale)}}</button>
    <button class="danger-button delete-button" bindtap="removeAccount" disabled="{{deleting}}">{{i18n.t('永久注销账户', locale)}}</button>
    <text class="account-note">{{i18n.t('注销会立即删除账户及全部个人数据。此操作无法撤销。', locale)}}</text>
  </block>
</view>
