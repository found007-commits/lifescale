.history-page { padding-top: 48rpx; }
.history-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16rpx; }
.history-head .section-title { display: block; margin-top: 14rpx; font-size: 46rpx; }
.ui-207 .add-button { width: auto; margin: 0; padding: 18rpx 26rpx; background: var(--text-primary); color: var(--bg-main); font-size: 25rpx; }
.history-note { display: block; margin: 20rpx 0 36rpx; color: var(--text-secondary); font-size: 25rpx; line-height: 1.7; }
.timeline { margin-top: 36rpx; }
.timeline-row { position: relative; padding: 0 0 36rpx 28rpx; border-left: 1rpx solid var(--border-active); }
.timeline-row::before { content: ""; position: absolute; left: -7rpx; top: 12rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--accent-gold); }
.timeline-date { margin-bottom: 18rpx; color: var(--text-secondary); font-family: var(--font-mono); font-size: 24rpx; line-height: 1.6; }
.history-card { padding: 24rpx; }
.history-content { display: block; margin: 22rpx 0; color: var(--text-primary); font-size: 29rpx; line-height: 1.75; white-space: pre-wrap; overflow-wrap: anywhere; }
.history-card .entry-actions button { padding: 16rpx; }
.load-more { margin-top: 16rpx; }
.empty-state { margin-top: 40rpx; }
.empty-state .muted { display: block; margin-top: 18rpx; line-height: 1.7; }
.empty-action { margin-top: 28rpx; }
