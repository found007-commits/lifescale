<view class="page-shell safe-page dashboard-page">
  <view wx:if="{{loading}}" class="loading-copy">正在打开今天</view>
  <block wx:else>
    <view wx:if="{{error}}" class="form-error">{{error}}</view>
    <block wx:if="{{profile && metrics}}">
      <view class="today-header">
        <text class="eyebrow">TODAY · {{metrics.today}}</text>
        <view class="display-title today-title"><text>{{metrics.isBonus ? '生命加时，今天又赚到一天。' : '今天，也值得被记住。'}}</text></view>
        <text class="muted">这不是死亡预测，而是你为自己设定的人生时间目标。</text>
      </view>

      <view class="life-card">
        <view class="dial" style="background: conic-gradient(#d99b2f {{metrics.progress}}%, rgba(243,239,229,.13) 0)">
          <view class="dial-inner">
            <text>{{metrics.isBonus ? '生命加时' : '仍可书写'}}</text>
            <text class="dial-number">{{metrics.displayDaysText}}</text>
            <text>天</text>
          </view>
        </view>
        <view class="metric-grid">
          <view><text>已走过</text><text class="metric-value">{{metrics.livedDaysText}} 天</text></view>
          <view><text>生命进度</text><text class="metric-value">{{metrics.progressText}}%</text></view>
          <view><text>剩余周数</text><text class="metric-value">{{metrics.weeksText}} 周</text></view>
          <view><text>留下记录</text><text class="metric-value">{{checkinCount}} 天</text></view>
        </view>
        <button class="today-button {{checkedToday ? 'done' : ''}}" bindtap="recordToday" hover-class="button-press">
          <text class="today-plus">{{checkedToday ? '✓' : '+1'}}</text>
          <view><text class="today-main">{{checkedToday ? '今天已经留下记录' : '记录今天 +1'}}</text><text class="today-note">一句话、一张图，也足够</text></view>
        </button>
      </view>

      <view class="recent-head">
        <view><text class="eyebrow">RECENT DAYS</text><text class="section-title">最近留下的日子</text></view>
        <button class="view-all" bindtap="viewHistory">查看全部</button>
      </view>
      <view wx:if="{{recentEntries.length}}" class="recent-list">
        <view wx:for="{{recentEntries}}" wx:key="id" class="paper-card entry-card">
          <image wx:if="{{item.imageUrl}}" class="entry-image" src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="entry-meta"><text>{{item.dateLabel}}</text><text>仅自己可见</text></view>
          <text class="entry-content">{{item.content || '今天 +1'}}</text>
          <view class="entry-tags"><text>{{item.moodLabel}}</text><text>{{item.categoryLabel}}</text></view>
        </view>
      </view>
      <view wx:else class="paper-card empty-state">
        <text class="section-title">第一条记录，从今天开始。</text>
        <text class="muted">无需写得完整，真实就好。</text>
        <button class="primary-button empty-action" bindtap="recordToday">记录今天 +1</button>
      </view>
    </block>
  </block>
</view>
