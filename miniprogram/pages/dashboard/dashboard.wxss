.dashboard-page { padding-top: 50rpx; }
.today-title { margin: 24rpx 0; font-size: 55rpx; }
.today-title text { white-space: normal; overflow-wrap: break-word; letter-spacing: -1rpx; line-height: 1.25; }
.today-header .muted { display: block; line-height: 1.7; }
.life-card { margin-top: 28rpx; padding: 30rpx; border-radius: 38rpx; background: #123f31; color: #f3efe5; }
.details-toggle { margin: 24rpx auto 0; padding: 8rpx 20rpx; width: fit-content; background: transparent; color: #d5e2da; font-size: 24rpx; }
.dial { width: 390rpx; height: 390rpx; margin: 0 auto; padding: 18rpx; border-radius: 50%; }
.dial-inner { width: 100%; height: 100%; border: 2rpx dashed rgba(243,239,229,.28); border-radius: 50%; background: #123f31; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #b8c9c0; font-size: 20rpx; letter-spacing: 4rpx; }
.dial-number { margin: 12rpx 0; color: #f3efe5; font-family: "Songti SC", serif; font-size: 74rpx; font-weight: 600; letter-spacing: -2rpx; line-height: 1; }
.metric-grid { margin-top: 42rpx; display: grid; grid-template-columns: 1fr 1fr; border-top: 2rpx solid rgba(243,239,229,.12); border-left: 2rpx solid rgba(243,239,229,.12); }
.metric-grid view { padding: 24rpx; border-right: 2rpx solid rgba(243,239,229,.12); border-bottom: 2rpx solid rgba(243,239,229,.12); color: #9eb3a8; font-size: 21rpx; }
.metric-value { display: block; margin-top: 8rpx; color: #f3efe5; font-size: 28rpx; font-weight: 650; }
.today-button { width: 100%; margin-top: 30rpx; padding: 22rpx 24rpx; border-radius: 28rpx; background: #d99b2f; color: #123f31; display: grid; grid-template-columns: 82rpx 1fr; align-items: center; text-align: left; }
.today-button.done { background: #dbe4dd; }
.today-plus { font-family: "Songti SC", serif; font-size: 54rpx; font-weight: 700; }
.today-main { display: block; font-size: 27rpx; font-weight: 700; }
.today-note { display: block; margin-top: 7rpx; font-size: 20rpx; opacity: .72; }
.recent-head { margin: 76rpx 0 28rpx; display: flex; align-items: flex-end; justify-content: space-between; }
.recent-head .section-title { display: block; margin-top: 10rpx; font-size: 40rpx; }
.view-all { margin: 0; padding: 0; background: transparent; color: #365f50; font-size: 23rpx; }
.recent-list { display: grid; gap: 24rpx; }
.entry-card { padding: 26rpx; }
.entry-image { width: 100%; height: 330rpx; margin-bottom: 22rpx; border-radius: 22rpx; }
.entry-meta { display: flex; justify-content: space-between; color: #83958c; font-size: 20rpx; }
.entry-content { display: block; margin: 20rpx 0; color: #234f40; font-family: "Songti SC", serif; font-size: 32rpx; line-height: 1.6; }
.entry-tags { display: flex; gap: 12rpx; }
.entry-tags text { padding: 8rpx 16rpx; border-radius: 999rpx; background: #eee9dc; color: #476b5d; font-size: 19rpx; }
.empty-state .muted { display: block; margin-top: 16rpx; }
.empty-action { margin-top: 30rpx; }

/* Mode changes affect hierarchy and information, not just the selected button. */
.life-gentle { background: #e3ece3; color: #234c37; border: 2rpx solid #cbdacc; }
.life-gentle .mode-options { background: #cbdacc; }
.life-gentle .mode-options button { color: #345640; }
.life-gentle .mode-options .chosen { background: #fffdf8; color: #234c37; }
.mode-message { display: block; margin: 32rpx 0; text-align: center; font-family: "Songti SC", serif; font-size: 31rpx; line-height: 1.6; }
.life-gentle .dial { width: 350rpx; height: 350rpx; padding: 10rpx; }
.life-gentle .dial-inner { border: 0; background: #e3ece3; color: #48654e; }
.life-gentle .dial-number { color: #234c37; font-size: 70rpx; }
.mode-disclaimer { display: block; margin-top: 32rpx; font-size: 21rpx; line-height: 1.6; text-align: center; }
.life-gentle .mode-disclaimer { color: #48654e; }
.life-gentle .details-toggle { color: #345640; }
.life-gentle .metric-grid, .life-gentle .metric-grid view { border-color: #c1d2c3; }
.life-gentle .metric-grid view { color: #48654e; }
.life-gentle .metric-value { color: #234c37; }
.life-clear { background: #202923; color: #fffaf0; border: 2rpx solid #202923; }
.life-clear .mode-options { background: #364239; }
.life-clear .mode-options button { color: #e1e8e0; }
.life-clear .mode-options .chosen { background: #ffbe8b; color: #202923; }
.clear-view { padding: 22rpx 4rpx 4rpx; }
.clear-label { display: block; color: #ffbe8b; font-size: 26rpx; font-weight: 650; }
.clear-count { display: flex; align-items: baseline; gap: 16rpx; margin: 16rpx 0 24rpx; flex-wrap: wrap; }
.clear-number { font-family: "DIN Alternate", "Arial", sans-serif; font-size: 112rpx; font-weight: 700; line-height: 1.1; letter-spacing: -4rpx; font-variant-numeric: tabular-nums; }
.clear-unit { font-size: 28rpx; color: #d4dfd4; }
.clear-message { display: block; font-size: 29rpx; line-height: 1.6; }
.clear-progress-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12rpx; margin-top: 44rpx; font-size: 23rpx; color: #d4dfd4; }
.clear-percent { color: #ffbe8b; font-size: 38rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.clear-progress-track { margin: 16rpx 0 20rpx; height: 16rpx; background: #526054; border-radius: 4rpx; overflow: hidden; }
.clear-progress-fill { height: 100%; background: #ffbe8b; }
.clear-facts { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12rpx; color: #d4dfd4; font-size: 22rpx; line-height: 1.6; }
.life-clear .mode-disclaimer { text-align: left; color: #b9c8bc; }
.life-clear .details-toggle { color: #e1e8e0; }
.life-card .mode-options button { min-height: 76rpx; display: flex; align-items: center; justify-content: center; line-height: 1.4; padding: 12rpx; }

/* The page background already turns dark. .life-card, .life-gentle, .life-clear and
   .today-button carry their own background, so they are left as designed. */
@media (prefers-color-scheme: dark) {
  .view-all { color: #9fd0b6; }
  .entry-content { color: #edf3ef; }
}
