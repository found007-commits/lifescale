.auth-page { padding-top: 64rpx; }
.auth-copy { margin-top: 44rpx; }
.auth-title { margin-top: 28rpx; font-size: 54rpx; }
.auth-intro { display: block; margin-top: 26rpx; line-height: 1.75; }
.auth-card { margin-top: 56rpx; padding: 18rpx 30rpx 34rpx; }
.auth-action { margin-top: 34rpx; }
.code-input { letter-spacing: 18rpx; font-size: 38rpx; font-weight: 700; }
.text-button { margin-top: 24rpx; background: transparent; color: #365f50; font-size: 24rpx; }
.auth-text-disabled { color: #99aaa2; }
.delivery-note { display: block; margin-top: 12rpx; color: #7f9188; font-size: 21rpx; line-height: 1.55; text-align: center; }
.privacy-note { margin: 34rpx 20rpx 0; }
.consent-row { margin-top: 28rpx; color: #365f50; font-size: 25rpx; line-height: 1.7; }
.consent-choice { display: flex; align-items: center; min-height: 72rpx; gap: 8rpx; }
.consent-links { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; padding-left: 60rpx; }
.policy-link { text-decoration: underline; text-underline-offset: 5rpx; font-weight: 600; padding: 8rpx 0; }
.consent-help { display: block; margin-top: 14rpx; font-size: 23rpx; line-height: 1.6; color: #51685d; }
.auth-card .auth-disabled { background: #e1e6e1 !important; color: #51685d !important; box-shadow: none; opacity: 1; }
.browse-action { text-decoration: underline; padding: 18rpx; }
.login-divider { display: block; margin-top: 38rpx; padding-top: 26rpx; border-top: 1rpx solid #cdd8d0; color: #51685d; font-size: 25rpx; }
.account-choice { margin-top: 30rpx; padding: 24rpx 0; }
.choice-title { font-size: 32rpx; font-weight: 600; }
.account-choice button { margin-top: 24rpx; }

/* The page background already turns dark, so consent and account chrome has to follow. */
@media (prefers-color-scheme: dark) {
  .text-button, .consent-row { color: #d5e2da; }
  .consent-help { color: #91a69b; }
  .login-divider { border-top-color: rgba(237, 243, 239, .14); color: #91a69b; }
}
