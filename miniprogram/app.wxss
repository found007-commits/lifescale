page {
  min-height: 100%;
  background: #f3efe5;
  color: #123f31;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, input, textarea, button, image, picker { box-sizing: border-box; }
button::after { border: 0; }

.page-shell { min-height: 100vh; padding: 44rpx 34rpx 120rpx; }
.safe-page { padding-bottom: calc(130rpx + env(safe-area-inset-bottom)); }
.brand-row { display: flex; align-items: center; gap: 18rpx; }
.brand-logo { width: 72rpx; height: 72rpx; border-radius: 22rpx; box-shadow: 0 14rpx 34rpx rgba(18, 63, 49, .12); }
.brand-name { font-family: "Songti SC", "STSong", serif; font-size: 36rpx; font-weight: 600; letter-spacing: 2rpx; }
.brand-note { display: block; margin-top: 2rpx; color: #70867b; font-size: 16rpx; letter-spacing: 5rpx; }
.eyebrow { color: #d99b2f; font-size: 18rpx; font-weight: 700; letter-spacing: 5rpx; }
.display-title { font-family: "Songti SC", "STSong", serif; font-size: 70rpx; font-weight: 500; line-height: 1.12; letter-spacing: -3rpx; }
.display-title text { display: block; white-space: nowrap; }
.section-title { font-family: "Songti SC", "STSong", serif; font-size: 46rpx; font-weight: 600; line-height: 1.18; }
.muted { color: #70867b; }
.gold { color: #d99b2f; }

.primary-button, .secondary-button, .danger-button {
  min-height: 96rpx;
  padding: 0 34rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1;
}
.primary-button { background: #123f31; color: #fbfaf6; box-shadow: 0 20rpx 42rpx rgba(18, 63, 49, .18); }
.primary-button[disabled] { background: #a7b5ae; color: #edf0ee; box-shadow: none; }
.secondary-button { border: 2rpx solid rgba(18, 63, 49, .22); background: transparent; color: #123f31; }
.danger-button { border: 2rpx solid rgba(163, 70, 61, .3); background: transparent; color: #a3463d; }
.button-press { transform: scale(.98); }

.field { margin-top: 30rpx; }
.field-label { display: block; margin-bottom: 14rpx; color: #365f50; font-size: 24rpx; font-weight: 650; }
.input, .textarea, .picker-field {
  width: 100%;
  min-height: 94rpx;
  padding: 0 28rpx;
  border: 2rpx solid rgba(18, 63, 49, .14);
  border-radius: 22rpx;
  background: #fbfaf6;
  color: #123f31;
  font-size: 30rpx;
}
.textarea { min-height: 280rpx; padding-top: 24rpx; line-height: 1.65; }
.picker-field { display: flex; align-items: center; justify-content: space-between; }
.field-help { margin-top: 10rpx; color: #7f9188; font-size: 21rpx; line-height: 1.55; }
.form-error { margin: 22rpx 0; padding: 20rpx 22rpx; border-left: 5rpx solid #a3463d; background: rgba(163, 70, 61, .08); color: #8d3d36; line-height: 1.55; }
.form-success { margin: 22rpx 0; color: #365f50; }

.paper-card { border: 2rpx solid rgba(18, 63, 49, .09); border-radius: 30rpx; background: #fbfaf6; box-shadow: 0 24rpx 60rpx rgba(18, 63, 49, .07); }
.empty-state { padding: 72rpx 38rpx; text-align: center; }
.empty-state .section-title { margin-bottom: 18rpx; }
.loading-copy { padding: 150rpx 0; color: #70867b; text-align: center; letter-spacing: 5rpx; }
.privacy-note { color: #7f9188; font-size: 21rpx; line-height: 1.65; text-align: center; }
.privacy-note navigator { display: inline; color: #365f50; font-weight: 650; }

.entry-share { display: block; margin: 22rpx 0 0 auto; width: fit-content; padding: 0 28rpx; background: transparent; border: 1rpx solid #b5c4bb; color: #365f50; font-size: 25rpx; border-radius: 999rpx; }
.entry-actions { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16rpx; margin-top: 22rpx; }
.entry-actions .entry-share { margin: 0 0 0 auto; }
.entry-delete { margin: 0; padding: 0 20rpx; min-height: 72rpx; display: flex; align-items: center; background: #f7eae6; color: #963f36; font-size: 25rpx; border-radius: 999rpx; }
.mode-options { display: flex; gap: 12rpx; margin-bottom: 28rpx; padding: 8rpx; border-radius: 24rpx; background: rgba(255,255,255,.12); }
.mode-options button { flex: 1; padding: 0 12rpx; font-size: 28rpx; color: #fffdf8; background: transparent; border-radius: 18rpx; }
.mode-options .chosen { background: #fffdf8; color: #143d2f; font-weight: 700; }
.journey-note { padding: 28rpx; margin-top: 28rpx; font-size: 27rpx; line-height: 1.8; }
.entry-photo-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin: 18rpx 0; }
.entry-photo-grid image { width: 100%; height: 220rpx; border-radius: 14rpx; margin: 0; }
.entry-photo-grid image:only-child { grid-column: 1 / -1; height: 380rpx; }
.journey-note text { display: block; }
.journey-note text:first-child { color: #a4731c; font-weight: 700; margin-bottom: 10rpx; }
@media (prefers-color-scheme: dark) {
  page { background: #0f1c17; color: #edf3ef; }
  .page-shell { background: #0f1c17; }
  .paper-card, .input, .textarea, .picker-field { border-color: rgba(237, 243, 239, .12); background: #192a22; color: #edf3ef; }
  .field-label, .secondary-button { color: #d5e2da; }
  .secondary-button { border-color: rgba(237, 243, 239, .22); }
  .muted, .field-help, .privacy-note { color: #91a69b; }
  .entry-share { color: #d5e2da; border-color: #728c7c; }
  .privacy-note navigator { color: #9fd0b6; }
  /* The media query above already turns the page dark, so these surfaces used to
     keep their light values and sit at roughly 1.5:1 against the background. */
  .primary-button { background: #3f7359; box-shadow: 0 20rpx 42rpx rgba(0, 0, 0, .35); }
  .primary-button[disabled] { background: #2b3f37; color: #7f9188; box-shadow: none; }
  .danger-button { border-color: rgba(217, 139, 130, .42); color: #d98b82; }
  .form-error { border-left-color: #d98b82; background: rgba(217, 139, 130, .12); color: #f0c3bc; }
  .form-success { color: #9fd0b6; }
  .brand-note, .loading-copy { color: #91a69b; }
  .entry-delete { background: rgba(217, 139, 130, .14); color: #e8ada4; }
  .media-placeholder { background: #192a22; color: #91a69b; }
  .journey-note text:first-child { color: #d99b2f; }
}
/* Heavy media is deliberately absent from list src attributes until opened. */
.media-placeholder { display: flex; align-items: center; justify-content: center; min-height: 200rpx; padding: 24rpx; border-radius: 20rpx; background: #e3ece3; color: #123f31; font-size: 26rpx; }
.entry-actions { flex-wrap: wrap; gap: 12rpx; }

/* 2.0.7: shared design tokens. Legacy selectors above deliberately remain for
   the pages outside this six-page visual revision. No network fonts or blur. */
page {
  --bg-main: #f5f5f7;
  --bg-card: #ffffff;
  --bg-card-hover: #ededf0;
  --border-subtle: #e0e0e5;
  --border-active: #a0a0aa;
  --text-primary: #1c1c1e;
  --text-secondary: #62626b;
  --text-tertiary: #72727b;
  --accent-gold: #80600b;
  --accent-gold-glow: #f7f1df;
  --text-danger: #a33737;
  --bg-danger: #faeeee;
  --font-mono: "DIN Alternate", "SF Pro Display", Menlo, monospace;
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 36rpx;
  --radius-full: 999rpx;
}
@media (prefers-color-scheme: dark) {
  page {
    --bg-main: #0a0a0c;
    --bg-card: #151518;
    --bg-card-hover: #222226;
    --border-subtle: #303036;
    --border-active: #62626b;
    --text-primary: #f5f5f7;
    --text-secondary: #b0b0b9;
    --text-tertiary: #9898a3;
    --accent-gold: #d4af37;
    --accent-gold-glow: #282316;
    --text-danger: #f0a3a3;
    --bg-danger: #302022;
  }
}
.ui-207 { background: var(--bg-main); color: var(--text-primary); padding: 40rpx 36rpx calc(48rpx + env(safe-area-inset-bottom)); font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
.ui-207.safe-page { padding-bottom: calc(72rpx + env(safe-area-inset-bottom)); }
.ui-207 .eyebrow { color: var(--accent-gold); font-size: 22rpx; letter-spacing: 3rpx; }
.ui-207 .display-title, .ui-207 .section-title { color: var(--text-primary); font-family: inherit; font-weight: 650; letter-spacing: -1rpx; line-height: 1.3; overflow-wrap: break-word; }
.ui-207 .display-title { font-size: 54rpx; }
.ui-207 .display-title text { white-space: normal; }
.ui-207 .section-title { font-size: 38rpx; }
.ui-207 .muted, .ui-207 .field-help, .ui-207 .privacy-note { color: var(--text-secondary); }
.ui-207 .gold { color: var(--accent-gold); }
.ui-207 .paper-card { background: var(--bg-card); border: 1rpx solid var(--border-subtle); border-radius: var(--radius-lg); box-shadow: none; }
.ui-207 button { box-sizing: border-box; min-height: 88rpx; padding: 18rpx 24rpx; border-radius: var(--radius-full); background: var(--bg-card-hover); color: var(--text-primary); font-size: 26rpx; line-height: 1.5; overflow-wrap: break-word; }
.ui-207 .primary-button { min-height: 100rpx; background: var(--text-primary); color: var(--bg-main); box-shadow: none; font-size: 30rpx; }
.ui-207 .secondary-button { background: transparent; border: 1rpx solid var(--border-active); color: var(--text-primary); box-shadow: none; }
.ui-207 .danger-button { background: var(--bg-danger); border-color: var(--text-danger); color: var(--text-danger); }
.ui-207 button[disabled] { opacity: .45; box-shadow: none; }
.ui-207 .field-label { color: var(--text-secondary); font-size: 25rpx; }
.ui-207 .field-help { display: block; font-size: 24rpx; line-height: 1.65; }
.ui-207 .input, .ui-207 .textarea, .ui-207 .picker-field { background: var(--bg-card); border: 1rpx solid var(--border-subtle); border-radius: var(--radius-sm); color: var(--text-primary); }
.ui-207 .form-error { background: var(--bg-danger); border-left-color: var(--text-danger); color: var(--text-danger); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; overflow-wrap: anywhere; }
.ui-207 .form-success { color: var(--text-primary); }
.ui-207 .loading-copy { color: var(--text-secondary); font-size: 26rpx; letter-spacing: 1rpx; }
.ui-207 .entry-actions { gap: 12rpx; }
.ui-207 .entry-actions button { margin: 0; font-size: 24rpx; padding: 16rpx 20rpx; }
.ui-207 .entry-actions .entry-delete { color: var(--text-danger); background: var(--bg-danger); }
.ui-207 .entry-actions .entry-share { margin-left: auto; color: var(--text-primary); background: transparent; border-color: var(--border-active); }
.ui-207 .media-placeholder { background: var(--bg-card-hover); color: var(--text-secondary); border: 1rpx solid var(--border-subtle); border-radius: var(--radius-sm); }
.ui-207 .entry-photo-grid { margin: 0 0 24rpx; }
.ui-207 .entry-photo-grid > view { min-width: 0; overflow: hidden; border-radius: var(--radius-sm); }
.ui-207 .entry-photo-grid image { display: block; width: 100%; height: 240rpx; border-radius: var(--radius-sm); }
.ui-207 .entry-photo-grid > view:only-child { grid-column: 1 / -1; }
.ui-207 .entry-photo-grid > view:only-child image { height: 360rpx; }
.ui-207 .entry-tags { display: flex; gap: 12rpx; flex-wrap: wrap; }
.ui-207 .entry-tags text { background: var(--bg-card-hover); color: var(--text-secondary); padding: 8rpx 16rpx; font-size: 22rpx; border-radius: var(--radius-full); }
@media (max-width: 360px) {
  .ui-207 { padding-left: 24rpx; padding-right: 24rpx; }
  .ui-207 .display-title { font-size: 48rpx; }
  .ui-207 .entry-actions button { padding-left: 16rpx; padding-right: 16rpx; }
}
