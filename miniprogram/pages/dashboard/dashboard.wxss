.dashboard-page { padding-top: 36rpx; }
.today-title { margin: 20rpx 0; }
.today-title text { white-space: normal; overflow-wrap: break-word; line-height: 1.3; }
.today-header .muted { display: block; font-size: 24rpx; line-height: 1.75; }
.ui-207 .today-button { display: flex; align-items: center; gap: 24rpx; width: 100%; margin-top: 30rpx; padding: 26rpx 28rpx; background: var(--text-primary); color: var(--bg-main); border-radius: var(--radius-md); text-align: left; }
.ui-207 .today-button.done { background: var(--accent-gold-glow); color: var(--accent-gold); border: 1rpx solid var(--border-subtle); }
.today-plus { flex-shrink: 0; font: 700 48rpx var(--font-mono); }
.today-main { display: block; font-size: 28rpx; font-weight: 650; }
.today-note { display: block; margin-top: 8rpx; font-size: 24rpx; line-height: 1.5; }
.life-card { margin-top: 28rpx; padding: 28rpx; border-radius: var(--radius-lg); border: 1rpx solid var(--border-subtle); }
.life-gentle { background: #f4f4f6; color: #1c1c1e; }
.life-clear { background: #111116; color: #f5f5f7; border-color: #303036; --accent-gold: #d4af37; --border-subtle: #303036; }
.life-card .mode-options { display: flex; gap: 8rpx; padding: 8rpx; margin-bottom: 28rpx; background: var(--bg-card-hover); border-radius: var(--radius-sm); }
.life-card .mode-options button { flex: 1; width: 0; min-width: 0; min-height: 88rpx; margin: 0; padding: 14rpx 8rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; background: transparent; color: var(--text-secondary); font-size: 27rpx; line-height: 1.4; }
.life-card .mode-options .chosen { background: var(--bg-card); color: var(--text-primary); font-weight: 700; }
.life-clear .mode-options { background: #242429; }
.life-clear .mode-options button { color: #b0b0b9; }
.life-clear .mode-options .chosen { background: #d4af37; color: #111116; }
.mode-message { display: block; margin: 32rpx 0; text-align: center; font-size: 29rpx; line-height: 1.7; }
.dial { width: 350rpx; height: 350rpx; max-width: 100%; margin: 0 auto; padding: 8rpx; border-radius: 50%; }
.dial-inner { width: 100%; height: 100%; border-radius: 50%; background: #f4f4f6; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--text-secondary); font-size: 23rpx; letter-spacing: 1rpx; }
.dial-number { margin: 16rpx 0; color: var(--text-primary); font: 650 66rpx var(--font-mono); letter-spacing: -2rpx; line-height: 1.15; }
.clear-view { padding: 16rpx 4rpx 4rpx; }
.clear-label { display: block; color: #d4af37; font-size: 25rpx; font-weight: 650; }
.clear-count { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12rpx; margin: 20rpx 0 24rpx; }
.clear-number { font-family: var(--font-mono); font-size: 102rpx; font-weight: 700; line-height: 1.15; letter-spacing: -3rpx; font-variant-numeric: tabular-nums; }
.clear-unit { color: #b0b0b9; font-size: 28rpx; }
.clear-message { display: block; font-size: 29rpx; line-height: 1.7; }
.clear-progress-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12rpx; margin-top: 40rpx; color: #b0b0b9; font-size: 24rpx; }
.clear-percent { color: #d4af37; font: 650 38rpx var(--font-mono); }
.clear-progress-track { height: 8rpx; margin: 18rpx 0 22rpx; background: #37373e; border-radius: 8rpx; overflow: hidden; }
.clear-progress-fill { height: 100%; background: #d4af37; }
.clear-facts { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12rpx; color: #b0b0b9; font-size: 23rpx; line-height: 1.7; }
.mode-disclaimer { display: block; margin-top: 32rpx; color: var(--text-secondary); text-align: center; font-size: 23rpx; line-height: 1.65; }
.life-clear .mode-disclaimer { color: #b0b0b9; text-align: left; }
.life-card .details-toggle { width: 100%; margin: 18rpx 0 0; padding: 18rpx 0; background: transparent; color: var(--text-primary); font-size: 25rpx; }
.life-clear .details-toggle { color: #f5f5f7; }
.metric-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24rpx; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--border-subtle); }
.metric-grid view { min-width: 0; color: var(--text-secondary); font-size: 24rpx; line-height: 1.6; }
.metric-value { display: block; margin-top: 10rpx; color: var(--text-primary); font-size: 28rpx; font-variant-numeric: tabular-nums; }
.life-clear .metric-grid view { color: #b0b0b9; }
.life-clear .metric-value { color: #f5f5f7; }
.ui-207 .journey-note { padding: 28rpx; font-size: 26rpx; }
.ui-207 .journey-note text:first-child { color: var(--accent-gold); font-family: var(--font-mono); }
.recent-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16rpx; margin: 52rpx 0 24rpx; }
.recent-head .section-title { display: block; margin-top: 10rpx; }
.ui-207 .view-all { margin: 0; padding: 18rpx 4rpx; background: transparent; color: var(--text-secondary); font-size: 24rpx; }
.recent-list { display: grid; gap: 24rpx; }
.entry-card { padding: 26rpx; }
.entry-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12rpx; color: var(--text-tertiary); font-size: 23rpx; }
.entry-content { display: block; margin: 24rpx 0; color: var(--text-primary); font-size: 30rpx; line-height: 1.75; white-space: pre-wrap; overflow-wrap: anywhere; }
.empty-state .muted { display: block; margin-top: 16rpx; line-height: 1.75; }
.empty-action { margin-top: 24rpx; }
@media (prefers-color-scheme: dark) { .life-gentle, .life-gentle .dial-inner { background: #1d1d23; color: #f5f5f7; } }
@media (max-width: 360px) { .life-card { padding: 22rpx; } .clear-number { font-size: 88rpx; } }
