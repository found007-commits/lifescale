.record-header { margin: 12rpx 0 32rpx; }
.record-title { margin: 20rpx 0; }
.record-intro { display: block; color: var(--text-secondary); font-size: 27rpx; line-height: 1.7; }
.composer { padding: 28rpx; }
.composer .textarea { min-height: 420rpx; height: 420rpx; border: 0; background: transparent; padding: 4rpx 0; font-size: 32rpx; line-height: 1.75; }
.ui-207 .inspiration-toggle { width: 100%; margin: 12rpx 0; padding: 16rpx 0; text-align: left; background: transparent; color: var(--text-secondary); font-size: 24rpx; }
.inspiration-options { padding-top: 12rpx; }
.choice-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.ui-207 .choice-pill { width: auto; margin: 0; padding: 16rpx 22rpx; border: 1rpx solid var(--border-subtle); background: var(--bg-card-hover); color: var(--text-secondary); font-size: 24rpx; }
.ui-207 .choice-pill.active { border-color: var(--accent-gold); background: var(--accent-gold-glow); color: var(--accent-gold); }
.inspiration-topics { margin-bottom: 24rpx; }
.inspiration-card { padding: 24rpx; margin-bottom: 24rpx; border-left: 3rpx solid var(--accent-gold); background: var(--accent-gold-glow); color: var(--text-primary); font-size: 27rpx; line-height: 1.75; }
.inspiration-card button { margin: 12rpx 0 0; padding: 16rpx 0; background: transparent; color: var(--accent-gold); text-align: left; font-size: 24rpx; }
.photo-choice-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.image-preview { position: relative; min-width: 0; margin-top: 16rpx; padding-bottom: 88rpx; border: 1rpx solid var(--border-subtle); border-radius: var(--radius-sm); overflow: hidden; background: var(--bg-main); }
.image-preview image { display: block; width: 100%; height: 210rpx; }
.image-preview .media-placeholder { min-height: 210rpx; border: 0; border-radius: 0; }
.image-preview > text { display: block; min-height: 150rpx; padding: 20rpx; color: var(--text-secondary); font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.image-preview button { position: absolute; bottom: 0; left: 0; right: 0; width: 100%; margin: 0; padding: 16rpx 8rpx; border-radius: 0; color: var(--text-danger); background: var(--bg-danger); font-size: 24rpx; }
.ui-207 .photo-button { width: 100%; margin: 24rpx 0 0; border: 1rpx dashed var(--border-active); border-radius: var(--radius-md); background: transparent; color: var(--text-primary); }
.upload-hint { display: block; margin-top: 20rpx; color: var(--text-secondary); font-size: 24rpx; line-height: 1.75; }
.record-metadata { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; margin-top: 32rpx; padding-top: 28rpx; border-top: 1rpx solid var(--border-subtle); }
.record-metadata > view { min-width: 0; }
.metadata-picker { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; min-height: 92rpx; padding: 18rpx; border: 1rpx solid var(--border-subtle); border-radius: var(--radius-sm); color: var(--text-primary); font-size: 26rpx; line-height: 1.5; }
.save-entry { margin-top: 32rpx; }
.render-canvas { position: fixed; left: -10000px; top: 0; width: 720px; height: 900px; pointer-events: none; }
.privacy-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 40; display: flex; align-items: center; justify-content: center; padding: 32rpx; background: rgba(0, 0, 0, .65); }
.privacy-dialog { width: 100%; max-height: 80vh; overflow-y: auto; padding: 36rpx 28rpx; border: 1rpx solid var(--border-active); border-radius: var(--radius-lg); background: var(--bg-card); }
.privacy-title { display: block; color: var(--text-primary); font-size: 28rpx; line-height: 1.75; }
.privacy-dialog .privacy-contract { margin: 20rpx 0 0; width: 100%; padding: 16rpx 0; background: transparent; color: var(--accent-gold); text-align: left; text-decoration: underline; font-size: 26rpx; }
.privacy-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.privacy-actions button { flex: 1; width: 0; min-width: 0; margin: 0; padding: 18rpx 12rpx; font-size: 27rpx; }
.privacy-actions .privacy-decline { border: 1rpx solid var(--border-active); background: transparent; color: var(--text-primary); }
