<wxs src="../../utils/locale.wxs" module="i18n" />
<view class="page-shell safe-page history-page">
  <view class="history-head">
    <view><text class="eyebrow">PRIVATE JOURNAL</text><text class="section-title">{{i18n.t('留下的日子', locale)}}</text></view>
    <button class="add-button" bindtap="addEntry">{{i18n.t('＋ 记录', locale)}}</button>
  </view>
  <text class="history-note">{{i18n.t('这些记录，仅自己可见。', locale)}}</text>
  <view wx:if="{{loading}}" class="loading-copy">{{i18n.t('正在翻开记录', locale)}}</view>
  <view wx:if="{{error}}" class="form-error">{{error}}</view>
  <view wx:if="{{!loading && entries.length}}" class="timeline">
    <view wx:for="{{entries}}" wx:key="id" class="timeline-row">
      <view class="timeline-date"><text>{{item.dateLabel}}</text></view>
      <view class="paper-card history-card">
        <view class="entry-photo-grid"><view wx:for="{{item.media}}" wx:for-item="media" wx:for-index="mediaIndex" wx:key="id" data-index="{{index}}" catchtap="openEntry" catchlongpress="openEntry"><image wx:if="{{media.kind === 'image' && media.signed_url}}" lazy-load="{{true}}" src="{{media.signed_url}}" mode="aspectFill" /><view wx:else class="media-placeholder">{{i18n.t(media.kind === 'video' ? '▶ 视频' : media.kind === 'gif' ? 'GIF 动图' : '查看图片', locale)}}</view></view></view>
        <text class="history-content">{{item.content || '今天 +1'}}</text>
        <view class="entry-tags"><text>{{i18n.t(item.moodLabel, locale)}}</text><text>{{i18n.t(item.categoryLabel, locale)}}</text></view>
        <view class="entry-actions">
          <button class="entry-delete" data-index="{{index}}" catchtap="removeEntry">{{i18n.t('删除', locale)}}</button>
          <button data-index="{{index}}" catchtap="openEntry">{{i18n.t('打开 · 留言', locale)}}</button>
          <button class="entry-share" data-index="{{index}}" catchtap="shareEntry">{{i18n.t('分享这一天 ↗', locale)}}</button>
        </view>
      </view>
    </view>
  </view>
  <button wx:if="{{more}}" loading="{{loadingMore}}" bindtap="loadMore">{{i18n.t('加载更多', locale)}}</button>
  <view wx:if="{{!loading && !entries.length}}" class="paper-card empty-state">
    <text class="section-title">{{i18n.t('这里会慢慢长出你的故事。', locale)}}</text>
    <text class="muted">{{i18n.t('今天先留下一句话。', locale)}}</text>
    <button class="primary-button empty-action" bindtap="addEntry">{{i18n.t('记录今天 +1', locale)}}</button>
  </view>
</view>
