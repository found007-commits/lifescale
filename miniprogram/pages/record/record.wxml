<wxs src="../../utils/locale.wxs" module="i18n" />
<view class="page-shell record-page">
  <text class="eyebrow">{{i18n.t('TODAY · 只属于你', locale)}}</text>
  <view class="display-title record-title"><text>{{i18n.t('今天，发生了什么？', locale)}}</text></view>
  <text class="record-intro">{{i18n.t('无需写得漂亮。一句话、一张图，或者只是此刻的心情。', locale)}}</text>

  <view class="paper-card composer">
    <text class="field-label">{{i18n.t('想从哪里写起？（可跳过）', locale)}}</text>
    <view class="choice-row inspiration-topics">
      <button class="choice-pill {{topic === -1 ? 'active' : ''}}" data-index="-1" bindtap="chooseTopic">{{i18n.t('自由写', locale)}}</button>
      <button wx:for="{{topics}}" wx:key="label" class="choice-pill {{topic === index ? 'active' : ''}}" data-index="{{index}}" bindtap="chooseTopic">{{i18n.t(item.label, locale)}}</button>
    </view>
    <view wx:if="{{prompt}}" class="inspiration-card"><text>{{i18n.t(prompt, locale)}}</text><button bindtap="nextPrompt">{{i18n.t('换一句', locale)}}</button></view>
    <textarea class="textarea" disabled="{{saving || persisted}}" value="{{content}}" bindinput="onContentInput" maxlength="12000" placeholder="{{i18n.t('写下你想记住的片刻……', locale)}}" auto-height="false" />
    <view class="photo-choice-grid">
    <view wx:for="{{images}}" wx:key="id" class="image-preview">
      <image wx:if="{{item.tempFilePath}}" src="{{item.tempFilePath}}" mode="aspectFill" />
      <text wx:else>{{item.error || i18n.t('正在处理照片…', locale)}}</text>
      <button data-index="{{index}}" disabled="{{saving || processing || persisted}}" bindtap="removeImage">{{index + 1}} · {{i18n.t('移除', locale)}}</button>
    </view>
    </view>
    <button class="photo-button" disabled="{{saving || processing || persisted}}" bindtap="chooseImage">{{i18n.t(processing ? '正在处理照片…' : '＋ 添加照片（可多选）', locale)}}</button>
    <text class="upload-hint">{{i18n.t('可继续添加。照片自动优化为静态 JPG，动图取单帧，不改变原文件。支持的相册格式由设备决定。', locale)}}</text>
    <text wx:if="{{notice}}" class="upload-hint">{{i18n.t(notice, locale)}}</text>
    <text wx:if="{{progress}}" class="upload-hint">{{i18n.t(processing ? '正在处理照片…' : '正在上传照片…', locale)}} {{progress}}</text>

    <view class="choice-block">
      <text class="field-label">{{i18n.t('此刻的心情', locale)}}</text>
      <view class="choice-row">
        <button wx:for="{{moods}}" wx:key="value" class="choice-pill {{mood === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="chooseMood">{{i18n.t(item.label, locale)}}</button>
      </view>
    </view>
    <view class="choice-block">
      <text class="field-label">{{i18n.t('这段时间属于', locale)}}</text>
      <view class="choice-row">
        <button wx:for="{{categories}}" wx:key="value" class="choice-pill {{category === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="chooseCategory">{{i18n.t(item.label, locale)}}</button>
      </view>
    </view>
    <view wx:if="{{error}}" class="form-error">{{error}}</view>
    <text wx:if="{{guest}}" class="upload-hint">{{i18n.t('此时尚未上传。登录后会继续保存；离开或关闭小程序会丢失未保存内容。', locale)}}</text>
    <button class="primary-button save-entry" bindtap="saveEntry" loading="{{saving}}" disabled="{{saving || processing || saved}}">{{i18n.t(saved ? '今天已留下' : (guest ? '登录并私密保存' : (persisted ? '重试剩余上传' : '仅自己可见，保存今天')), locale)}}</button>
  </view>
  <canvas type="2d" id="photoCanvas" class="render-canvas" />
</view>
